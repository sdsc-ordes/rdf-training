# q05 · Which recipes contain dairy, also hidden inside products?
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX rec:    <https://sdsc-ordes.github.io/rdf-training/vocab/recipes#>

SELECT DISTINCT ?name ?food WHERE {
  ?recipe schema:name ?name ;
          rec:hasIngredient/rec:containsIngredient* ?f .
  ?f a/rdfs:subClassOf* rec:DairyProduct ;
     rdfs:label ?food .
  FILTER(lang(?name) = "en")
}
ORDER BY ?name ?food
