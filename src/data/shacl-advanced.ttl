@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix rec:    <https://sdsc-ordes.github.io/rdf-training/vocab/recipes#> .
@prefix recsh:  <https://sdsc-ordes.github.io/rdf-training/vocab/recipes-shapes#> .

# SHACL beyond the Core constraints of ontology/shapes.ttl: a SHACL-SPARQL constraint and a SHACL rule.
# Both need an engine that supports them (pySHACL with advanced=True, TopBraid, EU ITB validator).

# --- SHACL-SPARQL ------------------------------------------------------------

# The vegan rule as SHACL-SPARQL, for comparison with the SHACL Core version.

# #region veganSparql
recsh:VeganRecipeSparqlShape a sh:NodeShape ;
    sh:targetClass schema:Recipe ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Vegan recipe uses animal product {?value}."@en ;
        sh:prefixes recsh:prefixes ;
        sh:select """
            SELECT $this ?value WHERE {
                $this schema:suitableForDiet schema:VeganDiet ;
                      rec:hasIngredient/rec:containsIngredient* ?value .
                ?value a/rdfs:subClassOf* rec:AnimalProduct .
            }
        """
    ] .
# #endregion veganSparql

recsh:prefixes
    sh:declare [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
        [ sh:prefix "schema" ; sh:namespace "https://schema.org/"^^xsd:anyURI ] ,
        [ sh:prefix "rec" ; sh:namespace "https://sdsc-ordes.github.io/rdf-training/vocab/recipes#"^^xsd:anyURI ] .

# --- SHACL rules -------------------------------------------------------------

# A SHACL rule (SHACL Advanced Features, 2017): a recipe with a cheese ingredient is a cheese dish.
# Infers the same types as the OWL definition
#   rec:CheeseDish owl:equivalentClass [ a owl:Restriction ;
#       owl:onProperty rec:hasIngredient ; owl:someValuesFrom rec:Cheese ] .
# rec:CheeseDish is declared in ontology/ontology.ttl.
# Run with pySHACL: shacl_rules(data, shacl_graph=shapes, advanced=True, iterate_rules=True)

# #region cheeseDishRule
recsh:CheeseDishRule a sh:NodeShape ;
    sh:targetClass schema:Recipe ;
    sh:rule [
        a sh:TripleRule ;
        sh:subject sh:this ;
        sh:predicate rdf:type ;
        sh:object rec:CheeseDish ;
        sh:condition [ sh:property [
            sh:path rec:hasIngredient ;
            sh:qualifiedValueShape [ sh:class rec:Cheese ] ;
            sh:qualifiedMinCount 1 ] ] ] .
# #endregion cheeseDishRule
