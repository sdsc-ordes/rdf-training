@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix rec:    <https://sdsc-ordes.github.io/rdf-training/vocab/recipes#> .

# Starter model. Extend it until it answers the competency questions.
# Reference solution: data/vocab/recipes.ttl

rec:Food a rdfs:Class ;
    rdfs:label "Food"@en .

rec:hasIngredient a rdf:Property ;
    rdfs:label "has ingredient"@en ;
    rdfs:domain schema:Recipe ;
    rdfs:range rec:Food .

